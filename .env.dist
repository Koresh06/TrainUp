APP_CONFIG__APP__APP_NAME=TrainUp
APP_CONFIG__APP__DEBUG=False
# логи: уровень (DEBUG/INFO/WARNING) и каталог файлов с ротацией (пусто — только консоль)
APP_CONFIG__APP__LOG_LEVEL=INFO
APP_CONFIG__APP__LOG_DIR=logs

APP_CONFIG__TELEGRAM__BOT_TOKEN=12345
APP_CONFIG__TELEGRAM__BOT_USERNAME=your_bot
APP_CONFIG__TELEGRAM__ADMIN_IDS=[1234]

APP_CONFIG__DB__POSTGRES__NAME=db
APP_CONFIG__DB__POSTGRES__PASSWORD=12345
APP_CONFIG__DB__POSTGRES__USER=user
APP_CONFIG__DB__POSTGRES__HOST=localhost
APP_CONFIG__DB__POSTGRES__PORT=5432
APP_CONFIG__DB__POSTGRES__ECHO=False

APP_CONFIG__DB__REDIS__HOST=localhost
APP_CONFIG__DB__REDIS__PORT=6379
APP_CONFIG__DB__REDIS__DB=0
APP_CONFIG__DB__REDIS__TASKIQ_DB=1

# --- Бизнес-параметры (дефолты — боевые значения) ---
APP_CONFIG__BUSINESS__TIMEZONE=Europe/Moscow
APP_CONFIG__BUSINESS__REMINDER_HOURS_BEFORE_TRAINING=2
APP_CONFIG__BUSINESS__REMINDER_TEST_MODE=False
APP_CONFIG__BUSINESS__REMINDER_TEST_DELAY_MINUTES=1
APP_CONFIG__BUSINESS__RECURRING_BOOKINGS_TEST_MODE=False
APP_CONFIG__BUSINESS__DEFAULT_CALENDAR_HORIZON_DAYS=14
APP_CONFIG__BUSINESS__DEFAULT_MAX_ACTIVE_BOOKINGS=1
APP_CONFIG__BUSINESS__CALENDAR_BUFFER_DAYS=60
APP_CONFIG__BUSINESS__PLAN_NEXT_TRAINING_REMINDER_DAYS=3
APP_CONFIG__BUSINESS__SUBSCRIPTION_WARNING_HOURS=[48, 3]
# пробный период нового тренера в днях (0 — без триала)
APP_CONFIG__BUSINESS__TRAINER_TRIAL_DAYS=7
# час (по APP_CONFIG__BUSINESS__TIMEZONE) утренней сводки тренеру, если он не выбрал своё
APP_CONFIG__BUSINESS__MORNING_DIGEST_HOUR=8
# через сколько дней без тренировок клиент попадает в «😴 Давно не были»
APP_CONFIG__BUSINESS__INACTIVE_CLIENT_DAYS=21
# реферальная программа тренеров: +дни подписки пригласившему после первой оплаты
# приглашённого и +дни к пробному периоду приглашённому (0 — без бонуса)
APP_CONFIG__BUSINESS__TRAINER_REFERRAL_BONUS_DAYS=30
APP_CONFIG__BUSINESS__TRAINER_REFERRAL_FRIEND_DAYS=7

# --- Оплата подписки (цены тарифов — в USD) ---
APP_CONFIG__PAYMENT__TEST_MODE=False
APP_CONFIG__PAYMENT__MANUAL__ENABLED=True
APP_CONFIG__PAYMENT__MANUAL__ADMIN_CONTACT=@admin_username
APP_CONFIG__PAYMENT__TELEGRAM_STARS__ENABLED=False
APP_CONFIG__PAYMENT__TELEGRAM_STARS__USD_PER_STAR=0.02
APP_CONFIG__PAYMENT__YOOKASSA__ENABLED=False
APP_CONFIG__PAYMENT__YOOKASSA__ACCOUNT_ID=0
APP_CONFIG__PAYMENT__YOOKASSA__SECRET_KEY=
APP_CONFIG__PAYMENT__YOOKASSA__RETURN_URL=https://bot.24timekeep.ru/payment/return
APP_CONFIG__PAYMENT__YOOKASSA__USD_TO_RUB_RATE=90
APP_CONFIG__PAYMENT__YOOKASSA__PROXY=

# --- HTTPS-прокси (Caddy) для webhook ЮKassa ---
# домен с A-записью на IP сервера; по умолчанию bot.24timekeep.ru
WEBHOOK_DOMAIN=bot.24timekeep.ru
